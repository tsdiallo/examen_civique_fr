# Public build-time variables (safe in the browser)
PUBLIC_APP_ENV=preprod
PUBLIC_SITE_URL=https://your-preprod-site.netlify.app
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only Netlify Function variables — never expose or commit real values
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
ADMIN_EMAILS=owner@example.com
