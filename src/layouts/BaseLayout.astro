---
import "../assets/styles/global.css";
import "../assets/styles/performance.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Examen civique français — Préparation en ligne",
  description = "Préparez l'examen civique français avec des parcours adaptés, des fiches, des quiz expliqués et un examen blanc chronométré. Gratuit, compte facultatif, plateforme indépendante.",
  ogImage = "/og-default.svg",
  ogType = "website",
  noindex = false,
  keywords = [
    "examen civique",
    "naturalisation française",
    "QCM civique",
    "carte de résident",
    "carte de séjour pluriannuelle",
    "valeurs République",
  ],
  jsonLd,
} = Astro.props;

const appEnvironment = import.meta.env.PUBLIC_APP_ENV ?? "production";
const isPreproduction = appEnvironment === "preprod";
const shouldNoindex = noindex || isPreproduction;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://examen-civique-fr.netlify.app").toString();
const ogImageAbs = new URL(ogImage, Astro.site ?? "https://examen-civique-fr.netlify.app").toString();
const siteName = "PrepaexamCivique";
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.toString() ?? "https://examen-civique-fr.netlify.app/",
  inLanguage: "fr-FR",
  description,
  publisher: {
    "@type": "Organization",
    name: siteName,
    url: Astro.site?.toString() ?? "https://examen-civique-fr.netlify.app/",
  },
};

const jsonLdArray = [
  websiteLd,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---
<!doctype html>
<html lang="fr" data-app-env={appEnvironment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="theme-color" content="#000091" />
    <meta name="author" content={siteName} />
    {shouldNoindex
      ? <meta name="robots" content="noindex, nofollow, noarchive" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    }
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/branding/prepaexam-civique-mark.svg" />
    <link rel="apple-touch-icon" href="/branding/prepaexam-civique-mark.svg" />
    {!isPreproduction && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${description}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLdArray.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-france-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-full focus:shadow-lift">
      Aller au contenu principal
    </a>
    {isPreproduction && (
      <div class="bg-ink-900 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.14em] text-white">
        Préproduction — données et parcours en cours de validation
      </div>
    )}
    <Header />
    <main id="main" class="flex-1 min-w-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
