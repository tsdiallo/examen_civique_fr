---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FicheHeader from "../../components/fiche/FicheHeader.astro";
import CTAQuiz from "../../components/fiche/CTAQuiz.astro";
import DiagnosticQuiz from "../../components/fiche/DiagnosticQuiz.astro";
import Flashcards from "../../components/fiche/Flashcards.astro";
import ThemeSidebar from "../../components/fiche/ThemeSidebar.astro";
import ContentReport from "../../components/fiche/ContentReport.astro";
import { getCollection } from "astro:content";
import { getQuizBySlug } from "../../lib/quiz-loader";
import { getThemeMetadata } from "../../data/theme-metadata";

export async function getStaticPaths() {
  const themes = (await getCollection("themes")).sort((a, b) => a.data.order - b.data.order);
  return themes.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      previousTheme: index > 0 ? themes[index - 1] : null,
      nextTheme: index < themes.length - 1 ? themes[index + 1] : null,
    },
  }));
}

const { entry, previousTheme, nextTheme } = Astro.props;
const { Content } = await entry.render();
const quiz = getQuizBySlug(entry.slug);
const metadata = getThemeMetadata(entry.slug);
const latestReview = metadata.sources.map((source) => source.verifiedAt).sort().at(-1);

const pageTitle = `${entry.data.title} — Fiche de révision`;
const description = `${entry.data.summary} Fiche interactive et sourcée pour préparer l'examen civique français.`;
const keywords = [
  entry.data.title.toLowerCase(),
  "examen civique",
  "naturalisation",
  "carte de résident",
  "fiche révision",
  ...(entry.data.tags ?? []),
];

const courseLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: entry.data.title,
  description: entry.data.summary,
  inLanguage: "fr-FR",
  learningResourceType: "Lesson",
  teaches: entry.data.title,
  timeRequired: entry.data.durationMin ? `PT${entry.data.durationMin}M` : undefined,
  dateModified: latestReview,
  citation: metadata.sources.map((source) => source.url),
  url: new URL(`/themes/${entry.slug}`, Astro.site ?? "https://examen-civique-fr.netlify.app").toString(),
  provider: {
    "@type": "Organization",
    name: "Examen civique",
    url: Astro.site?.toString() ?? "https://examen-civique-fr.netlify.app/",
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "online",
    courseWorkload: entry.data.durationMin ? `PT${entry.data.durationMin}M` : "PT10M",
    inLanguage: "fr-FR",
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: new URL("/", Astro.site ?? "https://examen-civique-fr.netlify.app").toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Thèmes",
      item: new URL("/themes", Astro.site ?? "https://examen-civique-fr.netlify.app").toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.data.title,
      item: new URL(`/themes/${entry.slug}`, Astro.site ?? "https://examen-civique-fr.netlify.app").toString(),
    },
  ],
};
---
<BaseLayout
  title={pageTitle}
  description={description}
  keywords={keywords}
  ogType="article"
  jsonLd={[courseLd, breadcrumbLd]}
>
  <section class="container-page pt-10 pb-6">
    <nav aria-label="Fil d’Ariane" class="flex flex-wrap items-center gap-2 text-sm text-ink-500">
      <a href="/" class="no-underline hover:underline">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href="/themes" class="no-underline hover:underline">Thèmes</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page" class="text-ink-700">{entry.data.title}</span>
    </nav>
    <FicheHeader
      order={entry.data.order}
      title={entry.data.title}
      summary={entry.data.summary}
      durationMin={entry.data.durationMin}
      tags={entry.data.tags}
    />
  </section>

  <section class="container-page pb-20">
    <div class="grid min-w-0 gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
      <main class="min-w-0">
        <section id="a-retenir" class="scroll-mt-28 rounded-3xl border border-france-200 bg-france-50/60 p-5 sm:p-7" aria-labelledby="takeaways-title">
          <p class="eyebrow">À retenir en 30 secondes</p>
          <h2 id="takeaways-title" class="mt-3 font-display text-2xl sm:text-3xl">L’essentiel avant de commencer</h2>
          <ul class="mt-5 space-y-3">
            {metadata.takeaways.map((takeaway) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-800 sm:text-base">
                <span aria-hidden="true" class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-france-700 text-xs font-bold text-white">✓</span>
                <span>{takeaway}</span>
              </li>
            ))}
          </ul>
        </section>

        {quiz && (
          <div id="diagnostic" class="scroll-mt-28">
            <DiagnosticQuiz questions={quiz.questions} />
          </div>
        )}

        <article class="prose-fr mt-12">
          <Content />
        </article>

        <Flashcards cards={metadata.flashcards} />

        {quiz && <CTAQuiz slug={entry.slug} questionsCount={quiz.questions.length} />}

        <ContentReport pagePath={`/themes/${entry.slug}`} />

        <nav class="mt-12 grid gap-4 border-t border-paper-300 pt-8 sm:grid-cols-2" aria-label="Navigation entre les thèmes">
          {previousTheme ? (
            <a href={`/themes/${previousTheme.slug}`} class="card card-hover block p-5 no-underline">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">← Thème précédent</span>
              <span class="mt-2 block font-display text-xl text-ink-900">{previousTheme.data.title}</span>
            </a>
          ) : <span></span>}
          {nextTheme && (
            <a href={`/themes/${nextTheme.slug}`} class="card card-hover block p-5 text-left no-underline sm:text-right">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">Thème suivant →</span>
              <span class="mt-2 block font-display text-xl text-ink-900">{nextTheme.data.title}</span>
            </a>
          )}
        </nav>
      </main>

      <ThemeSidebar
        officialTheme={metadata.officialTheme}
        sources={metadata.sources}
        durationMin={entry.data.durationMin}
      />
    </div>
  </section>
</BaseLayout>
