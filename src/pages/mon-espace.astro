---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EXAM_PATHS } from "../lib/learning/paths";
---
<BaseLayout
  title="Mon espace — Examen civique"
  description="Consultez votre parcours, votre maîtrise par thème et vos examens blancs."
  noindex={true}
>
  <section class="container-page py-12 sm:py-20">
    <div class="card-paper p-5 sm:p-6" data-account-loading>
      <p class="text-sm text-ink-700">Chargement sécurisé de votre espace…</p>
    </div>

    <div class="hidden" data-account-dashboard>
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Progression personnelle</p>
          <h1 class="mt-4 font-display text-display-sm sm:text-display">Mon espace</h1>
          <p class="mt-3 text-ink-700">Connecté avec <strong data-account-email></strong></p>
        </div>
        <button type="button" class="btn-secondary" data-sign-out>Se déconnecter</button>
      </div>

      <section class="mt-10 card-france p-5 sm:p-7">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <label for="selected-path" class="block font-semibold text-ink-900">Parcours préparé</label>
            <p class="mt-1 text-sm text-ink-600">Ce choix personnalise les recommandations et les examens blancs.</p>
            <select id="selected-path" class="mt-4 w-full max-w-xl rounded-xl border border-paper-300 bg-white px-4 py-3 text-ink-900" data-selected-path>
              {EXAM_PATHS.map((path) => <option value={path.slug}>{path.title}</option>)}
            </select>
          </div>
          <button type="button" class="btn-primary justify-center" data-save-path>Enregistrer</button>
        </div>
        <p class="mt-4 hidden text-sm" role="status" aria-live="polite" data-profile-status></p>
      </section>

      <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Résumé de progression">
        <article class="card p-5">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Thèmes travaillés</p>
          <p class="mt-3 font-display text-4xl" data-stat-themes>0</p>
        </article>
        <article class="card p-5">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Maîtrise moyenne</p>
          <p class="mt-3 font-display text-4xl"><span data-stat-mastery>0</span><span class="text-lg text-ink-500"> %</span></p>
        </article>
        <article class="card p-5">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Examens blancs</p>
          <p class="mt-3 font-display text-4xl" data-stat-attempts>0</p>
        </article>
        <article class="card p-5">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Meilleur score</p>
          <p class="mt-3 font-display text-4xl"><span data-stat-best>—</span><span class="text-lg text-ink-500" data-stat-best-total></span></p>
        </article>
      </section>

      <section class="mt-8 grid gap-6 lg:grid-cols-12">
        <article class="card p-5 sm:p-7 lg:col-span-7">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="eyebrow">À revoir</p>
              <h2 class="mt-3 font-display text-2xl">Progression par thème</h2>
            </div>
            <a href="/themes" class="btn-secondary">Réviser</a>
          </div>
          <ul class="mt-6 space-y-4" data-progress-list>
            <li class="text-sm text-ink-600">Aucune progression synchronisée pour le moment.</li>
          </ul>
        </article>

        <aside class="card-france p-5 sm:p-7 lg:col-span-5">
          <p class="eyebrow">Prochaine action</p>
          <h2 class="mt-3 font-display text-2xl">Continuer sans se disperser</h2>
          <p class="mt-3 text-sm text-ink-700">Révisez d’abord les notions sous 70 % de maîtrise, puis refaites un examen blanc complet.</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href="/themes" class="btn-primary justify-center">Reprendre les thèmes</a>
            <a href="/examen-blanc" class="btn-secondary justify-center">Faire l’examen blanc</a>
          </div>
        </aside>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabaseBrowserClient, isSupabaseConfigured } from "../lib/supabase/client";
  import { getCurrentSession, signOut } from "../lib/supabase/session";
  import { parseExamPath } from "../lib/learning/paths";

  const loading = document.querySelector<HTMLElement>("[data-account-loading]");
  const dashboard = document.querySelector<HTMLElement>("[data-account-dashboard]");
  const email = document.querySelector<HTMLElement>("[data-account-email]");
  const pathSelect = document.querySelector<HTMLSelectElement>("[data-selected-path]");
  const profileStatus = document.querySelector<HTMLElement>("[data-profile-status]");
  const progressList = document.querySelector<HTMLUListElement>("[data-progress-list]");

  function fail(message: string) {
    if (loading) loading.innerHTML = `<p class="text-sm text-marianne-600">${message}</p>`;
  }

  function setProfileStatus(message: string, success: boolean) {
    if (!profileStatus) return;
    profileStatus.textContent = message;
    profileStatus.className = `mt-4 text-sm ${success ? "text-success-700" : "text-marianne-600"}`;
  }

  async function loadDashboard() {
    if (!isSupabaseConfigured()) {
      fail("L'espace personnel sera disponible dès que Supabase sera configuré sur la préproduction.");
      return;
    }

    const session = await getCurrentSession();
    if (!session) {
      window.location.replace("/connexion?redirect=/mon-espace");
      return;
    }

    const client = getSupabaseBrowserClient();
    const user = session.user;
    if (email) email.textContent = user.email ?? "votre compte";

    const [profileResult, progressResult, attemptsResult] = await Promise.all([
      client.from("profiles").select("selected_path").eq("id", user.id).maybeSingle(),
      client.from("learning_progress").select("module_slug, mastery, next_review_at, last_attempt_at").order("mastery", { ascending: true }),
      client.from("exam_attempts").select("score, total, created_at").order("created_at", { ascending: false }).limit(50),
    ]);

    if (profileResult.error || progressResult.error || attemptsResult.error) {
      throw profileResult.error ?? progressResult.error ?? attemptsResult.error;
    }

    const storedPath = window.localStorage.getItem("ecfr.selectedPath");
    const selectedPath = parseExamPath(profileResult.data?.selected_path ?? storedPath);
    if (pathSelect) pathSelect.value = selectedPath;
    window.localStorage.setItem("ecfr.selectedPath", selectedPath);

    if (!profileResult.data) {
      await client.from("profiles").upsert({
        id: user.id,
        email: user.email ?? "",
        selected_path: selectedPath,
      });
    }

    const progress = progressResult.data ?? [];
    const attempts = attemptsResult.data ?? [];
    const mastery = progress.length
      ? Math.round(progress.reduce((total, row) => total + Number(row.mastery ?? 0), 0) / progress.length)
      : 0;
    const best = attempts.reduce<{ score: number; total: number } | null>((current, row) => {
      if (!current || row.score / row.total > current.score / current.total) return { score: row.score, total: row.total };
      return current;
    }, null);

    document.querySelector<HTMLElement>("[data-stat-themes]")!.textContent = String(progress.length);
    document.querySelector<HTMLElement>("[data-stat-mastery]")!.textContent = String(mastery);
    document.querySelector<HTMLElement>("[data-stat-attempts]")!.textContent = String(attempts.length);
    document.querySelector<HTMLElement>("[data-stat-best]")!.textContent = best ? String(best.score) : "—";
    document.querySelector<HTMLElement>("[data-stat-best-total]")!.textContent = best ? `/${best.total}` : "";

    if (progressList && progress.length) {
      progressList.innerHTML = "";
      progress.slice(0, 8).forEach((row) => {
        const masteryValue = Number(row.mastery ?? 0);
        const item = document.createElement("li");
        item.innerHTML = `
          <div class="flex items-center justify-between gap-4 text-sm">
            <span class="font-medium text-ink-900">${String(row.module_slug).replaceAll("-", " ")}</span>
            <span class="tabular-nums text-ink-600">${masteryValue} %</span>
          </div>
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-paper-200"><div class="h-full bg-france-700" style="width:${masteryValue}%"></div></div>
        `;
        progressList.appendChild(item);
      });
    }

    loading?.classList.add("hidden");
    dashboard?.classList.remove("hidden");
  }

  document.querySelector<HTMLButtonElement>("[data-save-path]")?.addEventListener("click", async () => {
    if (!pathSelect) return;
    const session = await getCurrentSession();
    if (!session) return;
    const selectedPath = parseExamPath(pathSelect.value);
    const { error } = await getSupabaseBrowserClient().from("profiles").upsert({
      id: session.user.id,
      email: session.user.email ?? "",
      selected_path: selectedPath,
    });
    if (error) {
      setProfileStatus("Impossible d'enregistrer le parcours.", false);
      return;
    }
    window.localStorage.setItem("ecfr.selectedPath", selectedPath);
    setProfileStatus("Parcours enregistré.", true);
  });

  document.querySelector<HTMLButtonElement>("[data-sign-out]")?.addEventListener("click", async () => {
    await signOut();
    window.location.assign("/");
  });

  loadDashboard().catch((error) => {
    console.error(error);
    fail("Impossible de charger votre espace. Reconnectez-vous ou réessayez plus tard.");
  });
</script>
