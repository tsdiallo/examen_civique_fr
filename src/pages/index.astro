---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgressSummary from "../components/ui/ProgressSummary.astro";
import AffiliateBlock from "../components/ui/AffiliateBlock.astro";
import { EXAM_PATHS, pathHome } from "../lib/learning/paths";
import type { Quiz } from "../lib/types";

const quizModules = import.meta.glob<Quiz>("../data/quizzes/*.json", {
  eager: true,
  import: "default",
});
const trainingQuestionCount = Object.values(quizModules).reduce(
  (total, quiz) => total + quiz.questions.length,
  0,
);
const siteUrl = Astro.site?.toString() ?? "https://examen-civique-fr.netlify.app/";

const orgLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "Examen civique",
  url: siteUrl,
  logo: new URL("/favicon.svg", siteUrl).toString(),
  description: "Plateforme gratuite et indépendante pour préparer l'examen civique français selon sa démarche.",
  inLanguage: "fr-FR",
  areaServed: "FR",
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Ce site est-il officiel ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non. Il s'agit d'une plateforme indépendante d'entraînement. Les sources officielles et dates de vérification sont indiquées lorsque nécessaire.",
      },
    },
    {
      "@type": "Question",
      name: "Faut-il créer un compte ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non. Le compte est facultatif. Sans compte, la progression reste enregistrée localement. Avec un compte, elle peut être synchronisée entre plusieurs appareils.",
      },
    },
    {
      "@type": "Question",
      name: "Comment est composé l'examen blanc ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "La simulation contient 40 questions en 45 minutes : 28 questions de connaissance et 12 mises en situation, avec un seuil indicatif de 32 bonnes réponses.",
      },
    },
  ],
};

const keywords = [
  "examen civique français",
  "naturalisation française",
  "carte de résident",
  "carte de séjour pluriannuelle",
  "QCM examen civique",
  "examen blanc civique",
];
---
<BaseLayout keywords={keywords} jsonLd={[orgLd, faqLd]}>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-warm-mesh"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-dots opacity-60 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"></div>

    <div class="container-page grid gap-10 pt-12 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-12 lg:items-center lg:pt-24 lg:pb-28">
      <div class="min-w-0 lg:col-span-7 animate-fade-up">
        <p class="eyebrow text-[0.68rem]">Plateforme indépendante · Compte facultatif</p>
        <h1 class="mt-5 font-display text-display-sm sm:text-display lg:text-display-lg leading-[1.02] text-balance">
          Préparez votre <em class="italic-accent">examen civique</em> avec le bon parcours.
        </h1>
        <p class="mt-5 max-w-2xl text-base text-ink-700 text-pretty sm:mt-6 sm:text-lg">
          Carte de séjour pluriannuelle, carte de résident ou naturalisation : choisissez votre démarche, révisez les notions, entraînez-vous et mesurez vos progrès.
        </p>
        <div class="mt-7 flex flex-col flex-wrap items-stretch gap-3 sm:flex-row sm:items-center">
          <a href="/parcours" class="btn-primary btn-lg justify-center">
            Choisir mon parcours
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/examen-blanc" class="btn-secondary btn-lg justify-center">Faire l'examen blanc</a>
        </div>

        <dl class="mt-10 flex max-w-2xl flex-wrap gap-x-8 gap-y-5 sm:mt-12">
          <div>
            <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink-500">Parcours</dt>
            <dd class="mt-1 font-display text-3xl text-ink-900 sm:text-4xl">3</dd>
          </div>
          <div>
            <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink-500">Questions d'entraînement</dt>
            <dd class="mt-1 font-display text-3xl text-ink-900 sm:text-4xl">{trainingQuestionCount}</dd>
          </div>
          <div>
            <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink-500">Examen blanc</dt>
            <dd class="mt-1 font-display text-3xl text-ink-900 sm:text-4xl">45<span class="align-middle font-sans text-sm text-ink-500"> min</span></dd>
          </div>
        </dl>
      </div>

      <div class="min-w-0 lg:col-span-5 animate-fade-up" style="animation-delay:0.1s">
        <div class="card-feature overflow-hidden p-0">
          <div class="stripe-tricolore" aria-hidden="true"></div>
          <div class="p-5 sm:p-7">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-france-700">Simulation structurée</p>
            <h2 class="mt-2 font-display text-3xl">40 questions</h2>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="rounded-2xl bg-france-50 p-4 ring-1 ring-france-200">
                <p class="font-display text-4xl text-france-700">28</p>
                <p class="mt-1 text-xs text-ink-700">Connaissances</p>
              </div>
              <div class="rounded-2xl bg-marianne-50 p-4 ring-1 ring-marianne-200">
                <p class="font-display text-4xl text-marianne-500">12</p>
                <p class="mt-1 text-xs text-ink-700">Mises en situation</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 text-sm text-ink-700">
              <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Seuil indicatif : 32/40</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Bilan par thème et par type</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Score local ou synchronisé avec un compte</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page">
    <ProgressSummary />
  </section>

  <section class="container-page pt-14 sm:pt-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Choisir sa démarche</p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] text-balance sm:text-4xl lg:text-5xl">
        Trois objectifs, <em class="italic-accent">trois parcours distincts</em>.
      </h2>
    </div>
    <div class="mt-9 grid gap-5 lg:grid-cols-3">
      {EXAM_PATHS.map((path, index) => (
        <article class="card-feature flex flex-col p-5 sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-france-50 font-display text-lg text-france-700 ring-1 ring-france-200">{index + 1}</span>
            <span class="badge-france">{path.level}</span>
          </div>
          <h3 class="mt-5 font-display text-2xl">{path.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-700">{path.description}</p>
          <a href={pathHome(path.slug)} class="btn-secondary mt-6 justify-center">Découvrir ce parcours</a>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page pt-16 sm:pt-20">
    <div class="grid gap-6 rounded-3xl border border-france-200 bg-white p-5 shadow-soft sm:p-8 lg:grid-cols-12 lg:items-center lg:p-10">
      <div class="min-w-0 lg:col-span-7">
        <p class="eyebrow">Une promesse claire</p>
        <h2 class="mt-4 font-display text-3xl leading-[1.1] text-balance sm:text-4xl lg:text-5xl">Gratuit, indépendant et transparent.</h2>
        <p class="mt-4 text-ink-700 text-pretty">
          Aucun compte n'est obligatoire. Les fonctionnalités de synchronisation sont facultatives. Certains liens de la rubrique « ressources » sont affiliés et toujours identifiés comme tels.
        </p>
        <ul class="mt-6 grid gap-3 text-sm text-ink-800 sm:grid-cols-2">
          <li class="flex gap-2"><span aria-hidden="true" class="text-france-700">✓</span> Parcours utilisable sans inscription</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-france-700">✓</span> Données de compte protégées par RLS</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-france-700">✓</span> Sources et vérifications éditoriales</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-france-700">✓</span> Liens commerciaux signalés</li>
        </ul>
      </div>
      <aside class="min-w-0 lg:col-span-5">
        <div class="card-paper p-5 sm:p-6">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink-500">Méthode recommandée</p>
          <ol class="mt-4 space-y-3 text-sm text-ink-800">
            <li class="flex gap-3"><span class="numeral shrink-0 text-base">01</span><span>Choisir le bon parcours.</span></li>
            <li class="flex gap-3"><span class="numeral shrink-0 text-base">02</span><span>Lire une fiche puis faire son quiz.</span></li>
            <li class="flex gap-3"><span class="numeral shrink-0 text-base">03</span><span>Revoir les notions sous 70 %.</span></li>
            <li class="flex gap-3"><span class="numeral shrink-0 text-base">04</span><span>Faire une simulation complète.</span></li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-page pt-14 sm:pt-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Ressources complémentaires</p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] text-balance sm:text-4xl lg:text-5xl">Approfondir avec des lectures <em class="italic-accent">clairement identifiées</em>.</h2>
    </div>
    <AffiliateBlock title="Sélection de ressources" />
  </section>

  <section class="container-page pt-14 pb-16 sm:pt-16 sm:pb-20">
    <div class="relative overflow-hidden rounded-3xl border border-paper-300 bg-white shadow-soft">
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-france-700/10 blur-3xl"></div>
      <div class="relative flex flex-col gap-6 p-6 sm:p-10 lg:flex-row lg:items-center lg:justify-between lg:p-12">
        <div class="max-w-2xl">
          <p class="eyebrow">Prêt à commencer ?</p>
          <h2 class="mt-3 font-display text-3xl leading-[1.1] text-balance sm:text-4xl lg:text-5xl">Choisissez votre démarche, puis avancez étape par étape.</h2>
        </div>
        <div class="flex flex-col flex-wrap gap-3 sm:flex-row">
          <a href="/parcours" class="btn-primary btn-lg justify-center">Choisir mon parcours</a>
          <a href="/connexion" class="btn-secondary btn-lg justify-center">Créer un compte</a>
        </div>
      </div>
      <div class="stripe-tricolore" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>
