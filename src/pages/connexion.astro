---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Connexion et création de compte — Examen civique"
  description="Créez un compte avec votre email et un mot de passe pour synchroniser votre progression."
  noindex={true}
>
  <section class="container-narrow py-12 sm:py-20">
    <div class="card p-5 sm:p-8">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Accès au compte">
        <button type="button" class="btn-primary" data-auth-mode="login" role="tab" aria-selected="true">Se connecter</button>
        <button type="button" class="btn-secondary" data-auth-mode="signup" role="tab" aria-selected="false">Créer un compte</button>
      </div>

      <div class="mt-7">
        <p class="eyebrow" data-auth-eyebrow>Votre espace</p>
        <h1 class="mt-3 font-display text-3xl sm:text-4xl" data-auth-title>Se connecter</h1>
        <p class="mt-3 text-sm text-ink-700" data-auth-description>
          Retrouvez votre parcours et votre progression sur vos appareils.
        </p>
      </div>

      <form class="mt-7 space-y-5" data-auth-form novalidate>
        <div>
          <label for="email" class="block text-sm font-semibold text-ink-900">Adresse email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="mt-2 w-full rounded-xl border border-paper-300 bg-white px-4 py-3 text-ink-900" />
        </div>
        <div>
          <label for="password" class="block text-sm font-semibold text-ink-900">Mot de passe</label>
          <input id="password" name="password" type="password" autocomplete="current-password" minlength="10" required class="mt-2 w-full rounded-xl border border-paper-300 bg-white px-4 py-3 text-ink-900" />
          <p class="mt-2 text-xs text-ink-500" data-password-hint>Au moins 10 caractères.</p>
        </div>
        <button type="submit" class="btn-primary btn-lg w-full justify-center" data-auth-submit>Se connecter</button>
      </form>

      <button type="button" class="mt-5 text-sm text-france-700 underline" data-reset-password>Mot de passe oublié ?</button>
      <p class="mt-5 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite" data-auth-status></p>

      <p class="mt-7 text-xs leading-relaxed text-ink-500">
        Votre progression anonyme reste utilisable sans compte. Avec un compte, seules les données nécessaires à votre apprentissage sont synchronisées.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabaseBrowserClient, isSupabaseConfigured } from "../lib/supabase/client";
  import { safeRedirectPath } from "../lib/supabase/session";

  const form = document.querySelector<HTMLFormElement>("[data-auth-form]");
  const emailInput = document.querySelector<HTMLInputElement>("#email");
  const passwordInput = document.querySelector<HTMLInputElement>("#password");
  const submit = document.querySelector<HTMLButtonElement>("[data-auth-submit]");
  const title = document.querySelector<HTMLElement>("[data-auth-title]");
  const description = document.querySelector<HTMLElement>("[data-auth-description]");
  const status = document.querySelector<HTMLElement>("[data-auth-status]");
  const reset = document.querySelector<HTMLButtonElement>("[data-reset-password]");
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-auth-mode]"));
  let mode: "login" | "signup" = "login";

  function showStatus(message: string, tone: "info" | "error" | "success" = "info") {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden", "border-france-200", "bg-france-50", "text-france-700", "border-marianne-200", "bg-marianne-50", "text-marianne-600", "border-success-200", "bg-success-50", "text-success-700");
    const tones = {
      info: ["border-france-200", "bg-france-50", "text-france-700"],
      error: ["border-marianne-200", "bg-marianne-50", "text-marianne-600"],
      success: ["border-success-200", "bg-success-50", "text-success-700"],
    } as const;
    status.classList.add(...tones[tone]);
  }

  function setMode(nextMode: "login" | "signup") {
    mode = nextMode;
    modeButtons.forEach((button) => {
      const active = button.dataset.authMode === mode;
      button.setAttribute("aria-selected", String(active));
      button.className = active ? "btn-primary" : "btn-secondary";
    });
    if (title) title.textContent = mode === "login" ? "Se connecter" : "Créer un compte";
    if (description) description.textContent = mode === "login"
      ? "Retrouvez votre parcours et votre progression sur vos appareils."
      : "Un email et un mot de passe suffisent. Vous devrez confirmer votre adresse email.";
    if (submit) submit.textContent = mode === "login" ? "Se connecter" : "Créer mon compte";
    if (passwordInput) passwordInput.autocomplete = mode === "login" ? "current-password" : "new-password";
    reset?.classList.toggle("hidden", mode === "signup");
    status?.classList.add("hidden");
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setMode(button.dataset.authMode === "signup" ? "signup" : "login"));
  });

  if (!isSupabaseConfigured()) {
    showStatus("La connexion sera activée dès que l'environnement de préproduction Supabase sera configuré.", "info");
    if (submit) submit.disabled = true;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !emailInput || !passwordInput || !submit) return;

    submit.disabled = true;
    showStatus("Vérification en cours…", "info");

    try {
      const client = getSupabaseBrowserClient();
      const email = emailInput.value.trim().toLowerCase();
      const password = passwordInput.value;

      if (mode === "signup") {
        const { error } = await client.auth.signUp({
          email,
          password,
          options: {
            emailRedirectTo: `${window.location.origin}/connexion?confirmed=1`,
          },
        });
        if (error) throw error;
        showStatus("Compte créé. Consultez votre boîte email pour confirmer votre adresse.", "success");
        return;
      }

      const { error } = await client.auth.signInWithPassword({ email, password });
      if (error) throw error;
      const redirect = safeRedirectPath(new URLSearchParams(window.location.search).get("redirect"));
      window.location.assign(redirect);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Une erreur est survenue.";
      showStatus(message, "error");
    } finally {
      submit.disabled = false;
    }
  });

  reset?.addEventListener("click", async () => {
    if (!emailInput?.value.trim()) {
      showStatus("Saisissez d'abord votre adresse email.", "error");
      emailInput?.focus();
      return;
    }
    try {
      const { error } = await getSupabaseBrowserClient().auth.resetPasswordForEmail(emailInput.value.trim().toLowerCase(), {
        redirectTo: `${window.location.origin}/connexion?reset=1`,
      });
      if (error) throw error;
      showStatus("Un lien de réinitialisation a été envoyé si cette adresse existe.", "success");
    } catch {
      showStatus("Impossible d'envoyer le lien de réinitialisation pour le moment.", "error");
    }
  });
</script>
