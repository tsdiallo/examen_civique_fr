---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EXAM_PATHS, pathHome } from "../../lib/learning/paths";

const pathDetails = {
  csp: {
    audience: "Première carte pluriannuelle",
    pace: "Essentiel et progressif",
    accent: "bg-france-50 text-france-700",
    highlights: ["Valeurs de la République", "Droits et devoirs essentiels", "Vie quotidienne en France"],
  },
  resident: {
    audience: "Installation durable en France",
    pace: "Approfondi et structuré",
    accent: "bg-success-50 text-success-700",
    highlights: ["Institutions françaises", "Droits, devoirs et citoyenneté", "Mises en situation concrètes"],
  },
  naturalisation: {
    audience: "Demande de nationalité française",
    pace: "Complet et exigeant",
    accent: "bg-marianne-50 text-marianne-600",
    highlights: ["Tous les thèmes civiques", "Questions de connaissances", "Situations et examen blanc complet"],
  },
} as const;
---
<BaseLayout
  title="Choisir mon parcours — Examen civique"
  description="Choisissez la démarche que vous préparez : carte de séjour pluriannuelle, carte de résident ou naturalisation française."
>
  <section class="container-page py-10 sm:py-14 lg:py-20" data-ui="path-picker-v2">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-france-200 bg-france-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-france-700">
        Étape 1 · Votre objectif
      </span>
      <h1 class="mt-5 font-display text-4xl leading-tight sm:text-5xl lg:text-6xl">Quelle démarche préparez-vous ?</h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-600 sm:text-lg">
        Choisissez votre situation pour recevoir les bonnes fiches, le bon niveau de difficulté et un examen blanc adapté.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:mt-14 lg:grid-cols-3">
      {EXAM_PATHS.map((path, index) => {
        const details = pathDetails[path.slug];
        return (
          <article
            class="group relative flex min-h-full flex-col overflow-hidden rounded-[1.75rem] border border-paper-300 bg-white p-6 shadow-soft transition duration-200 hover:-translate-y-1 hover:border-france-300 hover:shadow-lift sm:p-7"
            data-path-card
            data-path-slug={path.slug}
          >
            <div class="absolute inset-x-0 top-0 h-1 bg-paper-200 transition group-hover:bg-france-700" data-card-accent aria-hidden="true"></div>

            <div class="flex items-start justify-between gap-4">
              <span class:list={["inline-flex h-12 w-12 items-center justify-center rounded-2xl font-display text-xl font-semibold", details.accent]}>
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="hidden items-center gap-1.5 rounded-full bg-france-700 px-3 py-1 text-xs font-semibold text-white" data-selected-indicator>
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg>
                Sélectionné
              </span>
            </div>

            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.13em] text-ink-500">{details.audience}</p>
              <h2 class="mt-2 font-display text-2xl leading-tight sm:text-3xl">{path.title}</h2>
              <p class="mt-4 text-sm leading-relaxed text-ink-600">{path.description}</p>
            </div>

            <div class="mt-6 rounded-2xl bg-paper-50 p-4">
              <div class="flex items-center justify-between gap-3 text-sm">
                <span class="font-semibold text-ink-900">Niveau de préparation</span>
                <span class="badge-outline">{path.level}</span>
              </div>
              <p class="mt-2 text-xs text-ink-500">{details.pace}</p>
            </div>

            <ul class="mt-6 flex-1 space-y-3 text-sm text-ink-700">
              {details.highlights.map((highlight) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-success-50 text-success-700" aria-hidden="true">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l4 4L19 6"/></svg>
                  </span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <a
              href={pathHome(path.slug)}
              data-select-path={path.slug}
              data-path-short-title={path.shortTitle}
              class="btn-primary mt-7 w-full justify-center"
            >
              Choisir {path.shortTitle}
            </a>
          </article>
        );
      })}
    </div>

    <section class="mt-10 grid gap-5 rounded-[1.75rem] border border-paper-300 bg-paper-100 p-6 sm:grid-cols-3 sm:p-8" aria-label="Fonctionnement du parcours">
      <div class="flex gap-4">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white font-display text-france-700 shadow-soft">1</span>
        <div>
          <h2 class="font-display text-lg">Choisissez</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-600">Le parcours correspondant à votre démarche administrative.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white font-display text-france-700 shadow-soft">2</span>
        <div>
          <h2 class="font-display text-lg">Révisez</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-600">Les thèmes sont organisés pour progresser sans vous disperser.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white font-display text-france-700 shadow-soft">3</span>
        <div>
          <h2 class="font-display text-lg">Testez-vous</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-600">Terminez par une simulation chronométrée de 40 questions.</p>
        </div>
      </div>
    </section>

    <aside class="mt-6 flex flex-col gap-4 rounded-2xl border border-france-200 bg-france-50 p-5 text-sm text-ink-700 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-3xl leading-relaxed">
        <strong class="text-ink-900">Vous pourrez changer de parcours à tout moment.</strong>
        Le choix est enregistré sur votre appareil et, avec un compte, dans votre espace personnel.
      </p>
      <a href="/connexion" class="shrink-0 font-semibold text-france-700">Créer un compte</a>
    </aside>

    <p class="mt-6 text-center text-xs leading-relaxed text-ink-500">
      Plateforme pédagogique indépendante. Les sources officielles et leurs dates de vérification sont indiquées sur les fiches.
    </p>
  </section>
</BaseLayout>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-path-card]"));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-select-path]"));

  function highlightSelected(path: string | null) {
    cards.forEach((card) => {
      const selected = card.dataset.pathSlug === path;
      card.classList.toggle("ring-2", selected);
      card.classList.toggle("ring-france-700", selected);
      card.classList.toggle("border-transparent", selected);
      card.querySelector<HTMLElement>("[data-selected-indicator]")?.classList.toggle("hidden", !selected);
      card.querySelector<HTMLElement>("[data-selected-indicator]")?.classList.toggle("inline-flex", selected);
      const accent = card.querySelector<HTMLElement>("[data-card-accent]");
      accent?.classList.toggle("bg-france-700", selected);
      accent?.classList.toggle("bg-paper-200", !selected);
    });

    links.forEach((link) => {
      const selected = link.dataset.selectPath === path;
      const shortTitle = link.dataset.pathShortTitle ?? "ce parcours";
      link.textContent = selected ? "Continuer ce parcours" : `Choisir ${shortTitle}`;
      if (selected) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
  }

  const storedPath = window.localStorage.getItem("ecfr.selectedPath");
  highlightSelected(storedPath);

  links.forEach((link) => {
    link.addEventListener("click", () => {
      const path = link.dataset.selectPath;
      if (!path) return;
      window.localStorage.setItem("ecfr.selectedPath", path);
      highlightSelected(path);
    });
  });
</script>
