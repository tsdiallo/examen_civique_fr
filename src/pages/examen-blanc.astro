---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfficialExamRunner from "../components/exam/OfficialExamRunner.astro";
import Alert from "../components/ui/Alert.astro";
import { getCollection } from "astro:content";
import { getExam } from "../lib/quiz-loader";

const exam = await getExam();
const themes = await getCollection("themes");
const themeTitles: Record<string, string> = Object.fromEntries(
  themes.map((theme) => [theme.slug, theme.data.title]),
);

const total = 40;
const durationMin = 45;
const passing = 32;
const description = "Examen blanc civique personnalisé : 40 questions en 45 minutes, dont 28 connaissances et 12 mises en situation, pour la CSP, la carte de résident ou la naturalisation.";
const keywords = [
  "examen blanc civique",
  "simulation naturalisation",
  "carte de résident examen",
  "carte de séjour pluriannuelle examen",
  "QCM examen civique",
];

const examLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: "Examen blanc — Examen civique français",
  description,
  inLanguage: "fr-FR",
  learningResourceType: "Assessment",
  timeRequired: "PT45M",
  url: new URL("/examen-blanc", Astro.site ?? "https://examen-civique-fr.netlify.app").toString(),
  provider: {
    "@type": "Organization",
    name: "Examen civique",
    url: Astro.site?.toString() ?? "https://examen-civique-fr.netlify.app/",
  },
};
---
<BaseLayout
  title={`Examen blanc — ${total} questions en ${durationMin} minutes`}
  description={description}
  keywords={keywords}
  ogType="article"
  jsonLd={examLd}
>
  <section class="container-page pt-12 pb-6">
    <p class="eyebrow">Conditions proches de l'épreuve</p>
    <h1 class="mt-4 font-display text-display-sm sm:text-display text-balance">
      Examen <span class="text-gradient">blanc personnalisé</span>.
    </h1>
    <p class="mt-5 max-w-3xl text-ink-700 text-pretty">
      Choisissez votre démarche puis répondez à <strong>{total} questions</strong> en <strong>{durationMin} minutes</strong> :
      <strong>28 connaissances</strong>, <strong>12 mises en situation</strong> et un seuil indicatif de <strong>{passing}/{total}</strong>.
    </p>
  </section>

  <section class="container-page pb-20">
    {exam
      ? <OfficialExamRunner examBank={exam} themeTitles={themeTitles} />
      : <Alert tone="info" title="Examen indisponible">La banque de questions n'a pas pu être chargée.</Alert>
    }
  </section>
</BaseLayout>
