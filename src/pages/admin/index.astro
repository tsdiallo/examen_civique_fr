---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Administration — Examen civique"
  description="Tableau de bord d'administration sécurisé."
  noindex={true}
>
  <section class="container-page py-12 sm:py-20">
    <div class="card-paper p-5 sm:p-6" data-admin-loading>
      <p class="text-sm text-ink-700">Vérification de l'accès administrateur…</p>
    </div>

    <div class="hidden" data-admin-dashboard>
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Accès restreint</p>
          <h1 class="mt-4 font-display text-display-sm sm:text-display">Administration</h1>
          <p class="mt-3 text-ink-700">Session validée pour <strong data-admin-email></strong></p>
        </div>
        <a href="/mon-espace" class="btn-secondary">Retour à mon espace</a>
      </div>

      <section class="mt-10 grid gap-4 sm:grid-cols-3" aria-label="Indicateurs administrateur">
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Comptes utilisateurs</p>
          <p class="mt-3 font-display text-4xl" data-admin-users>0</p>
        </article>
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Examens enregistrés</p>
          <p class="mt-3 font-display text-4xl" data-admin-attempts>0</p>
        </article>
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Signalements ouverts</p>
          <p class="mt-3 font-display text-4xl" data-admin-reports>0</p>
        </article>
      </section>

      <section class="mt-8 card p-5 sm:p-7" aria-labelledby="reports-title">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Qualité éditoriale</p>
            <h2 id="reports-title" class="mt-3 font-display text-2xl">Signalements reçus</h2>
            <p class="mt-2 text-sm text-ink-700">Les textes sont affichés comme contenu brut et ne sont jamais interprétés comme du HTML.</p>
          </div>
          <button type="button" class="btn-secondary self-start" data-refresh-reports>Actualiser</button>
        </div>
        <p class="mt-5 text-sm text-ink-600" data-reports-loading>Chargement des signalements…</p>
        <ul class="mt-5 space-y-4" data-reports-list></ul>
        <p class="mt-5 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite" data-admin-status></p>
      </section>

      <section class="mt-8 grid gap-6 lg:grid-cols-12">
        <article class="card p-5 sm:p-7 lg:col-span-7">
          <p class="eyebrow">Sécurité</p>
          <h2 class="mt-3 font-display text-2xl">État de la plateforme</h2>
          <ul class="mt-6 space-y-3 text-sm text-ink-700">
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Accès admin vérifié côté serveur par JWT Supabase et allowlist email.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Aucune clé privilégiée n'est envoyée au navigateur.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Les données utilisateurs sont protégées par RLS.</span></li>
          </ul>
        </article>
        <aside class="card-france p-5 sm:p-7 lg:col-span-5">
          <p class="eyebrow">Préproduction</p>
          <h2 class="mt-3 font-display text-2xl">Avant toute mise en production</h2>
          <p class="mt-3 text-sm text-ink-700">Valider les comptes, les parcours, les examens 28/12, les signalements et les headers de sécurité. Le PR reste volontairement en draft.</p>
        </aside>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { isSupabaseConfigured } from "../../lib/supabase/client";
  import { getCurrentSession } from "../../lib/supabase/session";

  interface AdminReport {
    id: string;
    page_path: string;
    message: string;
    status: "open" | "resolved" | "dismissed";
    created_at: string;
    resolved_at: string | null;
  }

  const loading = document.querySelector<HTMLElement>("[data-admin-loading]");
  const dashboard = document.querySelector<HTMLElement>("[data-admin-dashboard]");
  const reportsList = document.querySelector<HTMLUListElement>("[data-reports-list]");
  const reportsLoading = document.querySelector<HTMLElement>("[data-reports-loading]");
  const adminStatus = document.querySelector<HTMLElement>("[data-admin-status]");
  let accessToken = "";

  function fail(message: string, action?: string) {
    if (!loading) return;
    loading.replaceChildren();
    const text = document.createElement("p");
    text.className = "text-sm text-marianne-600";
    text.textContent = message;
    loading.appendChild(text);
    if (action) {
      const link = document.createElement("a");
      link.className = "btn-secondary mt-4";
      link.href = action;
      link.textContent = "Se connecter";
      loading.appendChild(link);
    }
  }

  function showStatus(message: string, success: boolean) {
    if (!adminStatus) return;
    adminStatus.textContent = message;
    adminStatus.className = `mt-5 rounded-xl border px-4 py-3 text-sm ${success ? "border-success-200 bg-success-50 text-success-700" : "border-marianne-200 bg-marianne-50 text-marianne-600"}`;
  }

  async function apiRequest(path: string, init: RequestInit = {}) {
    const response = await fetch(path, {
      ...init,
      headers: {
        ...init.headers,
        Authorization: `Bearer ${accessToken}`,
      },
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error ?? "Erreur d'administration");
    return payload;
  }

  function createActionButton(label: string, status: "resolved" | "dismissed", report: AdminReport) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = status === "resolved" ? "btn-primary" : "btn-secondary";
    button.textContent = label;
    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        await apiRequest("/api/admin/reports", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: report.id, status }),
        });
        showStatus(status === "resolved" ? "Signalement marqué comme résolu." : "Signalement rejeté.", true);
        await loadReports();
      } catch (error) {
        showStatus(error instanceof Error ? error.message : "Action impossible.", false);
      } finally {
        button.disabled = false;
      }
    });
    return button;
  }

  function renderReports(reports: AdminReport[]) {
    if (!reportsList || !reportsLoading) return;
    reportsList.replaceChildren();
    reportsLoading.classList.toggle("hidden", reports.length > 0);
    reportsLoading.textContent = reports.length ? "" : "Aucun signalement enregistré.";

    for (const report of reports) {
      const item = document.createElement("li");
      item.className = "rounded-2xl border border-paper-300 bg-paper-50 p-5";

      const header = document.createElement("div");
      header.className = "flex flex-wrap items-center justify-between gap-3";
      const path = document.createElement("a");
      path.href = report.page_path.startsWith("/") ? report.page_path : "/";
      path.className = "text-sm font-semibold";
      path.textContent = report.page_path;
      const badge = document.createElement("span");
      badge.className = report.status === "open" ? "badge-marianne" : "badge-outline";
      badge.textContent = report.status === "open" ? "Ouvert" : report.status === "resolved" ? "Résolu" : "Rejeté";
      header.append(path, badge);

      const message = document.createElement("p");
      message.className = "mt-4 whitespace-pre-wrap text-sm leading-relaxed text-ink-800";
      message.textContent = report.message;

      const date = document.createElement("p");
      date.className = "mt-3 text-xs text-ink-500";
      date.textContent = new Intl.DateTimeFormat("fr-FR", { dateStyle: "medium", timeStyle: "short" }).format(new Date(report.created_at));

      item.append(header, message, date);
      if (report.status === "open") {
        const actions = document.createElement("div");
        actions.className = "mt-5 flex flex-wrap gap-2";
        actions.append(
          createActionButton("Marquer résolu", "resolved", report),
          createActionButton("Rejeter", "dismissed", report),
        );
        item.appendChild(actions);
      }
      reportsList.appendChild(item);
    }
  }

  async function loadReports() {
    if (reportsLoading) {
      reportsLoading.classList.remove("hidden");
      reportsLoading.textContent = "Chargement des signalements…";
    }
    const payload = await apiRequest("/api/admin/reports") as { reports: AdminReport[] };
    renderReports(payload.reports ?? []);
    const openCount = (payload.reports ?? []).filter((report) => report.status === "open").length;
    document.querySelector<HTMLElement>("[data-admin-reports]")!.textContent = String(openCount);
  }

  async function loadAdmin() {
    if (!isSupabaseConfigured()) {
      fail("L'administration sera activée dès que les variables Supabase et ADMIN_EMAILS seront configurées en préproduction.");
      return;
    }

    const session = await getCurrentSession();
    if (!session) {
      window.location.replace("/connexion?redirect=/admin");
      return;
    }
    accessToken = session.access_token;

    const payload = await apiRequest("/api/admin/overview") as {
      admin: { email: string };
      metrics: { users: number; examAttempts: number; openReports: number };
    };

    document.querySelector<HTMLElement>("[data-admin-email]")!.textContent = payload.admin.email;
    document.querySelector<HTMLElement>("[data-admin-users]")!.textContent = String(payload.metrics.users);
    document.querySelector<HTMLElement>("[data-admin-attempts]")!.textContent = String(payload.metrics.examAttempts);
    document.querySelector<HTMLElement>("[data-admin-reports]")!.textContent = String(payload.metrics.openReports);
    loading?.classList.add("hidden");
    dashboard?.classList.remove("hidden");
    await loadReports();
  }

  document.querySelector<HTMLButtonElement>("[data-refresh-reports]")?.addEventListener("click", () => {
    loadReports().catch((error) => showStatus(error instanceof Error ? error.message : "Actualisation impossible.", false));
  });

  loadAdmin().catch((error) => {
    console.error(error);
    fail("Impossible de charger l'administration. Vérifiez la configuration serveur ou reconnectez-vous.", "/connexion?redirect=/admin");
  });
</script>
