---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Administration — Examen civique"
  description="Tableau de bord d'administration sécurisé."
  noindex={true}
>
  <section class="container-page py-12 sm:py-20">
    <div class="card-paper p-5 sm:p-6" data-admin-loading>
      <p class="text-sm text-ink-700">Vérification de l'accès administrateur…</p>
    </div>

    <div class="hidden" data-admin-dashboard>
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Accès restreint</p>
          <h1 class="mt-4 font-display text-display-sm sm:text-display">Administration</h1>
          <p class="mt-3 text-ink-700">Session validée pour <strong data-admin-email></strong></p>
        </div>
        <a href="/mon-espace" class="btn-secondary">Retour à mon espace</a>
      </div>

      <section class="mt-10 grid gap-4 sm:grid-cols-3" aria-label="Indicateurs administrateur">
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Comptes utilisateurs</p>
          <p class="mt-3 font-display text-4xl" data-admin-users>0</p>
        </article>
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Examens enregistrés</p>
          <p class="mt-3 font-display text-4xl" data-admin-attempts>0</p>
        </article>
        <article class="card p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.14em] text-ink-500 font-semibold">Signalements ouverts</p>
          <p class="mt-3 font-display text-4xl" data-admin-reports>0</p>
        </article>
      </section>

      <section class="mt-8 grid gap-6 lg:grid-cols-12">
        <article class="card p-5 sm:p-7 lg:col-span-7">
          <p class="eyebrow">Qualité éditoriale</p>
          <h2 class="mt-3 font-display text-2xl">État de la plateforme</h2>
          <ul class="mt-6 space-y-3 text-sm text-ink-700">
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Accès admin vérifié côté serveur par JWT Supabase et allowlist email.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Aucune clé privilégiée n'est envoyée au navigateur.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-success-700">✓</span><span>Les données utilisateurs sont protégées par RLS.</span></li>
          </ul>
        </article>
        <aside class="card-france p-5 sm:p-7 lg:col-span-5">
          <p class="eyebrow">Préproduction</p>
          <h2 class="mt-3 font-display text-2xl">Avant toute mise en production</h2>
          <p class="mt-3 text-sm text-ink-700">Valider les comptes, les parcours, les examens 28/12, les signalements et les headers de sécurité. Le PR reste volontairement en draft.</p>
        </aside>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabaseBrowserClient, isSupabaseConfigured } from "../../lib/supabase/client";
  import { getCurrentSession } from "../../lib/supabase/session";

  const loading = document.querySelector<HTMLElement>("[data-admin-loading]");
  const dashboard = document.querySelector<HTMLElement>("[data-admin-dashboard]");

  function fail(message: string, action?: string) {
    if (!loading) return;
    loading.innerHTML = `<p class="text-sm text-marianne-600">${message}</p>${action ? `<p class="mt-4"><a class="btn-secondary" href="${action}">Se connecter</a></p>` : ""}`;
  }

  async function loadAdmin() {
    if (!isSupabaseConfigured()) {
      fail("L'administration sera activée dès que les variables Supabase et ADMIN_EMAILS seront configurées en préproduction.");
      return;
    }

    const session = await getCurrentSession();
    if (!session) {
      window.location.replace("/connexion?redirect=/admin");
      return;
    }

    const response = await fetch("/api/admin/overview", {
      headers: { Authorization: `Bearer ${session.access_token}` },
    });
    const payload = await response.json() as {
      error?: string;
      admin?: { email: string };
      metrics?: { users: number; examAttempts: number; openReports: number };
    };

    if (!response.ok || !payload.admin || !payload.metrics) {
      if (response.status === 403) {
        fail("Ce compte n'est pas autorisé à accéder à l'administration.");
        return;
      }
      throw new Error(payload.error ?? "Erreur administrateur");
    }

    document.querySelector<HTMLElement>("[data-admin-email]")!.textContent = payload.admin.email;
    document.querySelector<HTMLElement>("[data-admin-users]")!.textContent = String(payload.metrics.users);
    document.querySelector<HTMLElement>("[data-admin-attempts]")!.textContent = String(payload.metrics.examAttempts);
    document.querySelector<HTMLElement>("[data-admin-reports]")!.textContent = String(payload.metrics.openReports);
    loading?.classList.add("hidden");
    dashboard?.classList.remove("hidden");
  }

  loadAdmin().catch((error) => {
    console.error(error);
    fail("Impossible de charger l'administration. Vérifiez la configuration serveur ou reconnectez-vous.", "/connexion?redirect=/admin");
  });
</script>
