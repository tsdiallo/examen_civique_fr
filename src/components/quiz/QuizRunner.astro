---
import type { Quiz } from "../../lib/types";

interface Props {
  quiz: Quiz;
  themeTitle: string;
}
const { quiz, themeTitle } = Astro.props;
const payload = JSON.stringify(quiz);
---
<section
  class="quiz-root"
  data-quiz={payload}
  data-theme-slug={quiz.themeSlug}
  data-theme-title={themeTitle}
  aria-live="polite"
>
  <div class="card p-5 sm:p-7">
    <div class="flex items-center justify-between gap-3 text-sm text-ink-500 flex-wrap">
      <span class="font-semibold text-ink-700 tabular-nums" data-qr-progress-label>Question 1 sur {quiz.questions.length}</span>
      <span class="badge-france" data-qr-type>QCM</span>
    </div>
    <div class="mt-3">
      <div class="h-1.5 rounded-full bg-paper-200 overflow-hidden">
        <div class="h-full bg-france-700 transition-[width] duration-300" style="width: 0%" data-qr-bar></div>
      </div>
    </div>

    <h2 class="mt-6 text-xl sm:text-2xl font-display text-ink-900 text-pretty leading-snug" data-qr-prompt></h2>

    <fieldset class="mt-6 space-y-2.5" data-qr-choices>
      <legend class="sr-only">Choisissez une réponse</legend>
    </fieldset>

    <div class="mt-6 hidden" data-qr-explanation>
      <div class="rounded-2xl border border-paper-300 bg-paper-50 p-4 sm:p-5 text-sm">
        <p class="font-semibold mb-1" data-qr-verdict></p>
        <p class="text-ink-700 leading-relaxed" data-qr-explanation-text></p>
      </div>
    </div>

    <div class="mt-7 flex items-center justify-between gap-2 flex-wrap">
      <button type="button" class="btn-ghost order-1" data-qr-prev>← Précédent</button>
      <div class="flex gap-2 order-2 ml-auto">
        <button type="button" class="btn-secondary" data-qr-check>Valider</button>
        <button type="button" class="btn-primary hidden" data-qr-next>Suivant →</button>
      </div>
    </div>
  </div>

  <div class="card-france p-5 sm:p-7 mt-6 hidden" data-qr-result>
    <p class="eyebrow">Résultat</p>
    <h2 class="mt-3 font-display text-2xl sm:text-3xl text-ink-900">Bilan du quiz</h2>
    <p class="mt-2 text-ink-700">
      Vous avez obtenu <strong class="text-france-700 tabular-nums" data-qr-score></strong> sur <strong class="tabular-nums" data-qr-total></strong>.
    </p>
    <div class="mt-5">
      <div class="h-2 rounded-full bg-paper-200 overflow-hidden">
        <div class="h-full bg-success-600 transition-[width] duration-500" style="width: 0%" data-qr-score-bar></div>
      </div>
    </div>
    <p class="mt-4 text-sm text-ink-700" data-qr-feedback></p>
    <p class="mt-3 text-xs text-ink-500">Le résultat reste local sans compte et se synchronise automatiquement lorsque vous êtes connecté.</p>
    <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
      <button type="button" class="btn-secondary justify-center" data-qr-retry>Recommencer</button>
      <a href="/themes" class="btn-ghost justify-center">Retour aux thèmes</a>
      <a href="/examen-blanc" class="btn-marianne justify-center">Tenter l'examen blanc</a>
    </div>
  </div>
</section>

<script>
  import { saveThemeAttempt } from "../../lib/progress";
  import { syncThemeProgress } from "../../lib/progress/cloud";
  import type { Quiz, Question, ChoiceId } from "../../lib/types";

  const root = document.querySelector<HTMLElement>(".quiz-root");
  if (!root) throw new Error("QuizRunner root missing");
  const quiz: Quiz = JSON.parse(root.dataset.quiz || "{}");
  const slug = root.dataset.themeSlug || "";

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    root.querySelector<T>(`[data-qr-${sel}]`);

  const els = {
    progress: $("progress-label")!,
    type: $("type")!,
    bar: $("bar") as HTMLElement,
    prompt: $("prompt")!,
    choices: $("choices") as HTMLFieldSetElement,
    explanation: $("explanation")!,
    explanationText: $("explanation-text")!,
    verdict: $("verdict")!,
    prev: $("prev") as HTMLButtonElement,
    check: $("check") as HTMLButtonElement,
    next: $("next") as HTMLButtonElement,
    result: $("result")!,
    score: $("score")!,
    total: $("total")!,
    scoreBar: $("score-bar") as HTMLElement,
    feedback: $("feedback")!,
    retry: $("retry") as HTMLButtonElement,
  };

  let index = 0;
  let selected: (ChoiceId | null)[] = quiz.questions.map(() => null);
  let validated: boolean[] = quiz.questions.map(() => false);
  let finalSaved = false;

  function render() {
    const question: Question = quiz.questions[index];
    els.progress.textContent = `Question ${index + 1} sur ${quiz.questions.length}`;
    els.type.textContent = question.type === "situation" ? "Mise en situation" : "QCM";
    els.prompt.textContent = question.prompt;
    els.bar.style.width = `${index / quiz.questions.length * 100}%`;

    els.choices.innerHTML = "";
    question.choices.forEach((choice) => {
      const id = `q${question.id}-${choice.id}`;
      const label = document.createElement("label");
      label.className = "flex items-start gap-3 p-4 rounded-2xl border border-paper-300 bg-white transition-all duration-150 hover:border-france-400 hover:bg-france-50/40 cursor-pointer has-[:checked]:border-france-700 has-[:checked]:bg-france-50";
      label.innerHTML = `
        <input type="radio" id="${id}" name="q-${question.id}" value="${choice.id}" class="mt-1 accent-france-700" ${selected[index] === choice.id ? "checked" : ""} ${validated[index] ? "disabled" : ""} />
        <span class="text-ink-900 leading-relaxed"><span class="font-display font-semibold text-france-700 mr-2">${choice.id.toUpperCase()}.</span>${choice.text}</span>
      `;
      const input = label.querySelector<HTMLInputElement>("input")!;
      input.addEventListener("change", () => {
        selected[index] = input.value as ChoiceId;
        els.check.disabled = false;
      });
      els.choices.appendChild(label);

      if (validated[index]) {
        if (choice.id === question.answer) {
          label.classList.add("!border-success-600", "!bg-success-50");
        } else if (choice.id === selected[index]) {
          label.classList.add("!border-marianne-400", "!bg-marianne-50");
        }
      }
    });

    if (validated[index]) {
      const correct = selected[index] === question.answer;
      els.explanation.classList.remove("hidden");
      els.verdict.textContent = correct ? "✓ Bonne réponse" : "✗ Réponse incorrecte";
      els.verdict.className = `font-semibold mb-1 ${correct ? "text-success-700" : "text-marianne-500"}`;
      els.explanationText.textContent = question.explanation;
      els.check.classList.add("hidden");
      els.next.classList.remove("hidden");
      els.next.textContent = index === quiz.questions.length - 1 ? "Voir le résultat" : "Suivant →";
    } else {
      els.explanation.classList.add("hidden");
      els.check.classList.remove("hidden");
      els.next.classList.add("hidden");
      els.check.disabled = selected[index] == null;
    }

    els.prev.disabled = index === 0;
  }

  els.check.addEventListener("click", () => {
    if (selected[index] == null) return;
    validated[index] = true;
    render();
  });
  els.next.addEventListener("click", () => {
    if (index < quiz.questions.length - 1) {
      index += 1;
      render();
    } else {
      showResult();
    }
  });
  els.prev.addEventListener("click", () => {
    if (index > 0) { index -= 1; render(); }
  });
  els.retry.addEventListener("click", () => {
    index = 0;
    selected = quiz.questions.map(() => null);
    validated = quiz.questions.map(() => false);
    finalSaved = false;
    els.result.classList.add("hidden");
    render();
    root.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  function showResult() {
    const correct = quiz.questions.reduce(
      (total, question, questionIndex) => total + (selected[questionIndex] === question.answer ? 1 : 0),
      0,
    );
    const total = quiz.questions.length;
    const wrongConcepts = quiz.questions
      .filter((question, questionIndex) => selected[questionIndex] !== question.answer)
      .map((question) => question.id);

    els.score.textContent = String(correct);
    els.total.textContent = String(total);
    els.scoreBar.style.width = `${correct / total * 100}%`;
    const percentage = Math.round(correct / total * 100);
    els.feedback.textContent =
      percentage >= 80 ? "Excellent — vous maîtrisez ce thème."
      : percentage >= 60 ? "Bon début — relisez les pièges fréquents."
      : "À retravailler — reprenez la fiche, puis refaites le quiz.";
    els.result.classList.remove("hidden");
    els.bar.style.width = "100%";

    if (!finalSaved && slug) {
      saveThemeAttempt(slug, correct);
      void syncThemeProgress({
        moduleSlug: slug,
        correct,
        total,
        wrongConcepts,
      }).catch((error) => console.warn("Quiz sync skipped", error));
      finalSaved = true;
    }
    els.result.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  render();
</script>
