---
import type { Flashcard } from "../../data/theme-metadata";

interface Props {
  cards: Flashcard[];
}
const { cards } = Astro.props;
---
<section
  class="mt-12 overflow-hidden rounded-3xl border border-paper-300 bg-white shadow-soft"
  aria-labelledby="flashcards-title"
  data-ui="flashcards-mobile-v2"
  data-flashcards-root
>
  <div class="border-b border-paper-300 bg-gradient-to-br from-france-50/90 via-white to-paper-50 p-4 sm:p-6">
    <div class="flex items-start gap-3 sm:gap-4">
      <span
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-france-200 bg-white text-france-700 shadow-soft sm:h-12 sm:w-12"
        aria-hidden="true"
      >
        <svg data-icon="flashcards" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="5" width="14" height="14" rx="2"></rect>
          <path d="M8 5V3h10a2 2 0 0 1 2 2v10h-2"></path>
          <path d="M8 10h6M8 14h4"></path>
        </svg>
      </span>

      <div class="min-w-0 flex-1">
        <p class="eyebrow">Mémoriser</p>
        <h2 id="flashcards-title" class="mt-2 break-words font-display text-2xl leading-tight sm:text-3xl">
          Flashcards de révision
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-700">
          Essayez de répondre, puis ouvrez la carte pour vérifier votre réponse.
        </p>
      </div>
    </div>

    <button
      type="button"
      class="btn-secondary mt-4 w-full justify-center whitespace-normal text-center sm:ml-auto sm:flex sm:w-auto sm:whitespace-nowrap"
      aria-pressed="false"
      data-reveal-all
    >
      <svg data-icon="eye" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.1 12s3.6-6 9.9-6 9.9 6 9.9 6-3.6 6-9.9 6-9.9-6-9.9-6Z"></path>
        <circle cx="12" cy="12" r="2.5"></circle>
      </svg>
      <span data-reveal-all-label>Afficher toutes les réponses</span>
    </button>
  </div>

  <ul class="grid grid-cols-1 gap-3 p-3 sm:gap-4 sm:p-5 md:grid-cols-2">
    {cards.map((card, index) => {
      const cardNumber = String(index + 1).padStart(2, "0");
      const buttonId = `flashcard-button-${index}`;
      const answerId = `flashcard-answer-${index}`;

      return (
        <li class="min-w-0 overflow-hidden rounded-2xl border border-paper-300 bg-white shadow-soft transition-shadow hover:shadow-lift">
          <button
            id={buttonId}
            type="button"
            class="group grid w-full grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-3 p-4 text-left sm:p-5"
            aria-expanded="false"
            aria-controls={answerId}
            data-flashcard
          >
            <span
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-france-50 text-france-700 ring-1 ring-inset ring-france-200"
              aria-hidden="true"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3h12a2 2 0 0 1 2 2v16l-8-4-8 4V5a2 2 0 0 1 2-2Z"></path>
              </svg>
            </span>

            <span class="min-w-0">
              <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-france-700">
                Carte {cardNumber}
              </span>
              <span class="mt-2 block break-words font-display text-lg leading-snug text-ink-900 sm:text-xl">
                {card.front}
              </span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-france-700 sm:text-sm">
                <svg class="h-4 w-4 shrink-0 group-aria-expanded:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.1 12s3.6-6 9.9-6 9.9 6 9.9 6-3.6 6-9.9 6-9.9-6-9.9-6Z"></path>
                  <circle cx="12" cy="12" r="2.5"></circle>
                </svg>
                <svg class="hidden h-4 w-4 shrink-0 group-aria-expanded:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m3 3 18 18"></path>
                  <path d="M10.6 10.7a2 2 0 0 0 2.8 2.8"></path>
                  <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c6.3 0 9.9 6 9.9 6a17 17 0 0 1-2.1 2.7M6.6 6.7C3.7 8.5 2.1 12 2.1 12s3.6 6 9.9 6c1 0 2-.2 2.9-.5"></path>
                </svg>
                <span data-flashcard-action-label>Voir la réponse</span>
              </span>
            </span>

            <span
              class="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-100 text-ink-600 transition-transform group-aria-expanded:rotate-180 group-aria-expanded:bg-france-50 group-aria-expanded:text-france-700"
              aria-hidden="true"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </button>

          <div
            id={answerId}
            class="hidden border-t border-france-100 bg-france-50/55 px-4 py-4 sm:px-5 sm:py-5"
            role="region"
            aria-labelledby={buttonId}
            data-flashcard-answer
          >
            <div class="flex items-start gap-3">
              <span
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white text-france-700 ring-1 ring-inset ring-france-200"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18h6"></path>
                  <path d="M10 22h4"></path>
                  <path d="M8.7 14.8A7 7 0 1 1 15.3 14.8c-.8.6-1.3 1.3-1.3 2.2h-4c0-.9-.5-1.6-1.3-2.2Z"></path>
                </svg>
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-france-700">Réponse</p>
                <p class="mt-1 break-words text-sm leading-relaxed text-ink-800 sm:text-base">{card.back}</p>
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<script>
  const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-flashcards-root]"));

  roots.forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flashcard]"));
    const revealAll = root.querySelector<HTMLButtonElement>("[data-reveal-all]");
    const revealAllLabel = root.querySelector<HTMLElement>("[data-reveal-all-label]");

    function setExpanded(card: HTMLButtonElement, expanded: boolean) {
      card.setAttribute("aria-expanded", String(expanded));
      const answerId = card.getAttribute("aria-controls");
      if (answerId) document.getElementById(answerId)?.classList.toggle("hidden", !expanded);

      const actionLabel = card.querySelector<HTMLElement>("[data-flashcard-action-label]");
      if (actionLabel) actionLabel.textContent = expanded ? "Masquer la réponse" : "Voir la réponse";
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        setExpanded(card, card.getAttribute("aria-expanded") !== "true");
        const allExpanded = cards.every((item) => item.getAttribute("aria-expanded") === "true");
        revealAll?.setAttribute("aria-pressed", String(allExpanded));
        if (revealAllLabel) {
          revealAllLabel.textContent = allExpanded ? "Masquer toutes les réponses" : "Afficher toutes les réponses";
        }
      });
    });

    revealAll?.addEventListener("click", () => {
      const shouldReveal = cards.some((card) => card.getAttribute("aria-expanded") !== "true");
      cards.forEach((card) => setExpanded(card, shouldReveal));
      revealAll.setAttribute("aria-pressed", String(shouldReveal));
      if (revealAllLabel) {
        revealAllLabel.textContent = shouldReveal ? "Masquer toutes les réponses" : "Afficher toutes les réponses";
      }
    });
  });
</script>
