---
const nav = [
  { href: "/parcours", label: "Parcours" },
  { href: "/themes", label: "Réviser" },
  { href: "/examen-blanc", label: "Examen blanc" },
  { href: "/a-propos", label: "À propos" },
];
const DONATION_URL = "https://buy.stripe.com/fZu4gy2ZodYJ8pEbxj7g400";
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href + "/");
---
<header class="sticky top-0 z-40" data-ui="header-v2">
  <div class="stripe-tricolore" aria-hidden="true"></div>
  <div class="border-b border-paper-300 bg-white/95 shadow-[0_4px_24px_-20px_rgba(0,0,0,0.55)] backdrop-blur-xl supports-[backdrop-filter]:bg-white/88">
    <div class="container-page flex h-[4.5rem] items-center justify-between gap-3">
      <a href="/" class="group flex min-w-0 items-center no-underline" aria-label="PrepaexamCivique — accueil">
        <picture class="block shrink-0">
          <source
            media="(min-width: 640px)"
            srcset="/branding/prepaexam-civique-logo.svg"
            type="image/svg+xml"
          />
          <img
            src="/branding/prepaexam-civique-mark.svg"
            alt="PrepaexamCivique"
            class="h-11 w-auto max-w-[13rem] object-contain transition-transform duration-200 group-hover:-translate-y-0.5 sm:h-10 sm:max-w-[12rem]"
            loading="eager"
            decoding="async"
          />
        </picture>
      </a>

      <nav class="hidden items-center gap-3 lg:flex" aria-label="Navigation principale">
        <ul class="flex items-center rounded-full bg-paper-100 p-1 text-sm">
          {nav.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "inline-flex rounded-full px-3.5 py-2 font-semibold no-underline transition",
                    active
                      ? "bg-white text-france-700 shadow-soft"
                      : "text-ink-600 hover:bg-white/70 hover:text-france-700",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <a
          href={DONATION_URL}
          rel="nofollow noopener"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold text-ink-600 no-underline transition hover:bg-marianne-50 hover:text-marianne-600"
          aria-label="Soutenir le site — paiement sécurisé par Stripe, ouvre un nouvel onglet"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span>Soutenir</span>
        </a>

        <a href="/connexion?redirect=/mon-espace" class="btn-primary px-4 py-2.5" data-account-link>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
          <span data-account-label>Se connecter</span>
        </a>
      </nav>

      <div class="flex items-center gap-2 lg:hidden">
        <a href="/connexion?redirect=/mon-espace" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-france-700 text-white no-underline shadow-soft" data-account-link aria-label="Accéder à mon espace">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
          <span class="sr-only" data-account-label>Se connecter</span>
        </a>
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-paper-300 bg-white text-ink-800 transition hover:bg-paper-100"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-btn
        >
          <svg class="h-5 w-5 block" data-menu-icon-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
          <svg class="h-5 w-5 hidden" data-menu-icon-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>

    <nav id="mobile-nav" aria-label="Navigation mobile" class="hidden border-t border-paper-300 bg-white lg:hidden" data-menu-panel>
      <div class="container-page py-4">
        <ul class="grid gap-1">
          {nav.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center justify-between rounded-2xl px-4 py-3.5 font-semibold no-underline transition",
                    active ? "bg-france-50 text-france-700" : "text-ink-800 hover:bg-paper-100",
                  ]}
                  aria-current={active ? "page" : undefined}
                  data-mobile-nav-link
                >
                  <span>{item.label}</span>
                  <svg class="h-4 w-4 opacity-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="mt-4 grid gap-2 border-t border-paper-300 pt-4 sm:grid-cols-2">
          <a href="/connexion?redirect=/mon-espace" class="btn-primary w-full justify-center" data-account-link data-mobile-nav-link>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            <span data-account-label>Se connecter</span>
          </a>
          <a href={DONATION_URL} rel="nofollow noopener" target="_blank" class="btn-secondary w-full justify-center">
            <svg class="h-4 w-4 text-marianne-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Soutenir le site
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { getSupabaseBrowserClient, isSupabaseConfigured } from "../../lib/supabase/client";

  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const openIcon = document.querySelector<SVGElement>("[data-menu-icon-open]");
  const closeIcon = document.querySelector<SVGElement>("[data-menu-icon-close]");
  const accountLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-account-link]"));
  const accountLabels = Array.from(document.querySelectorAll<HTMLElement>("[data-account-label]"));

  function setMenuOpen(open: boolean, restoreFocus = false) {
    if (!btn || !panel || !openIcon || !closeIcon) return;
    panel.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
    openIcon.classList.toggle("hidden", open);
    openIcon.classList.toggle("block", !open);
    closeIcon.classList.toggle("hidden", !open);
    closeIcon.classList.toggle("block", open);
    document.body.classList.toggle("overflow-hidden", open && window.innerWidth < 1024);
    if (restoreFocus) btn.focus();
  }

  function updateAccountNavigation(signedIn: boolean) {
    accountLinks.forEach((link) => {
      link.href = signedIn ? "/mon-espace" : "/connexion?redirect=/mon-espace";
      link.setAttribute("aria-label", signedIn ? "Ouvrir mon espace" : "Se connecter");
    });
    accountLabels.forEach((label) => {
      label.textContent = signedIn ? "Mon espace" : "Se connecter";
    });
  }

  btn?.addEventListener("click", () => setMenuOpen(btn.getAttribute("aria-expanded") !== "true"));
  document.querySelectorAll<HTMLElement>("[data-mobile-nav-link]").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") setMenuOpen(false, true);
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  if (isSupabaseConfigured()) {
    const client = getSupabaseBrowserClient();
    client.auth.getSession().then(({ data }) => updateAccountNavigation(Boolean(data.session))).catch(() => updateAccountNavigation(false));
    client.auth.onAuthStateChange((_event, session) => updateAccountNavigation(Boolean(session)));
  } else {
    updateAccountNavigation(false);
  }
</script>
